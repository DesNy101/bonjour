# --- Core ---
APP_ENV=development            # development | production
SECRET_KEY=replace-with-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql://postgres:password@localhost:5432/bonjour
# --- First Super Administrator (created on first start if no users exist) ---
# One-time key for creating the first admin at /#/setup (works only while there are no users)
SETUP_KEY=
ADMIN_NAME=Bonjour Administrator
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password-here
# --- Sessions / cookies ---
SESSION_HOURS=12
COOKIE_SECURE=auto             # auto = secure cookies in production
# --- Paystack (optional; leave blank to use the manual payment workflow) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# --- Notifications (optional providers; in-app notifications always work) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_KEY=
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
